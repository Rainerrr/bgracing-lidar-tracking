# Pinned by digest (ros:jazzy-ros-base-noble, Ubuntu 24.04, amd64 + arm64).
FROM ros:jazzy-ros-base-noble@sha256:8eed0a4669bbf43ee331878a4c39bd8ebddea8e3312a58b4fae8edb14526b617

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-numpy \
        python3-scipy \
        python3-sklearn \
        python3-matplotlib \
        python3-pytest \
        python3-yaml \
        ros-jazzy-sensor-msgs-py \
        ros-jazzy-tf2-ros \
        ros-jazzy-foxglove-bridge \
    && rm -rf /var/lib/apt/lists/*

ENV ROS_HOME=/tmp/ros
# core/ (shared data layer + pose math) is importable as `core`; ROS's setup.bash keeps /app on PYTHONPATH.
ENV PYTHONPATH=/app
WORKDIR /app
COPY core/ /app/core/
COPY processor/ /app/processor/
COPY scripts/ /app/scripts/
COPY tests/ /app/tests/

# /ros_entrypoint.sh (from the base image) sources /opt/ros/jazzy/setup.bash. umask 000 makes everything written to
# the mounted /output (files 0666, folders 0777) readable and deletable by the host user, whatever its uid: the
# container runs as root, so on a Linux host the files would otherwise be root-owned.
ENTRYPOINT ["/bin/sh", "-c", "umask 000 && exec /ros_entrypoint.sh \"$@\"", "sh"]
CMD ["ros2", "launch", "/app/processor/processor.launch.py"]
