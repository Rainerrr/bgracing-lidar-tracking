# Pinned by digest (ros:jazzy-ros-base-noble, Ubuntu 24.04, amd64 + arm64).
FROM ros:jazzy-ros-base-noble@sha256:8eed0a4669bbf43ee331878a4c39bd8ebddea8e3312a58b4fae8edb14526b617

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-numpy \
        ros-jazzy-sensor-msgs-py \
        ros-jazzy-tf2-ros \
    && rm -rf /var/lib/apt/lists/*

ENV ROS_HOME=/tmp/ros
WORKDIR /app
COPY publisher/ /app/publisher/

# /ros_entrypoint.sh (from the base image) sources /opt/ros/jazzy/setup.bash.
CMD ["python3", "/app/publisher/kitti_lidar_publisher.py", "--ros-args", "--params-file", "/config/publisher.yaml"]
